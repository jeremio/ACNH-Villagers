{
  "name": "list-villagers",
  "type": "module",
  "version": "2.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "description": "Display villagers from Animal Crossing New Horizons with optimized filtering",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "knip": "knip",
    "analyze": "vite build --mode analyze",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "performance": "pnpm analyze && pnpm preview",
    "prepare": "husky",
    "check": "pnpm type-check && pnpm lint && pnpm knip && pnpm test"
  },
  "dependencies": {
    "@lucide/vue": "^1.55.0",
    "naive-ui": "^2.45.3",
    "pinia": "^4.0.3",
    "vfonts": "^0.0.3",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@playwright/test": "^1.64.0",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node26": "^26.0.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/language-server": "^3.3.13",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "happy-dom": "^20.14.6",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.13"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix"
    ]
  }
}
